{
  "claude": {
    "description": "Anthropic Claude — functional style, immutable patterns",
    "patterns": {
      "const-ratio": {
        "description": "Prefers const over let/var",
        "threshold": 0.80,
        "weight": 0.25
      },
      "import-type-usage": {
        "description": "Uses 'import type' for type-only imports",
        "threshold": 0.30,
        "weight": 0.20
      },
      "functional-methods": {
        "description": "Prefers .map/.filter/.reduce over loops",
        "keywords": ["map", "filter", "reduce", "flatMap", "forEach", "some", "every", "find"],
        "weight": 0.20
      },
      "arrow-functions": {
        "description": "Prefers arrow functions over function declarations",
        "threshold": 0.70,
        "weight": 0.15
      },
      "readonly-usage": {
        "description": "Uses Readonly<>, readonly modifier",
        "keywords": ["Readonly", "readonly"],
        "weight": 0.10
      },
      "object-freeze": {
        "description": "Uses Object.freeze for immutability",
        "keywords": ["Object.freeze"],
        "weight": 0.10
      }
    }
  },
  "gpt": {
    "description": "OpenAI GPT/ChatGPT — verbose comments, explanatory style",
    "patterns": {
      "pre-function-comments": {
        "description": "'This function does X' pattern before functions",
        "regex": "^\\s*(//|/\\*\\*?)\\s*(This|The)\\s+(function|method|class)",
        "weight": 0.30
      },
      "step-comments": {
        "description": "Step-by-step inline comments (Step 1, Step 2, etc.)",
        "regex": "^\\s*//\\s*(Step\\s+\\d|First|Then|Next|Finally)",
        "weight": 0.25
      },
      "obvious-comments": {
        "description": "Comments that explain obvious code",
        "regex": "^\\s*//\\s*(Get|Set|Check|Return|Create|Initialize|Define|Calculate)\\s+(the|a|an)",
        "weight": 0.25
      },
      "export-block": {
        "description": "Exports all functions at the bottom in a block",
        "weight": 0.10
      },
      "generic-naming": {
        "description": "Heavy use of generic names: data, result, response, value",
        "weight": 0.10
      }
    }
  },
  "copilot": {
    "description": "GitHub Copilot — short completions, minimal context",
    "patterns": {
      "short-functions": {
        "description": "Functions are 5-15 lines, completion-sized",
        "minLength": 3,
        "maxLength": 18,
        "weight": 0.35
      },
      "no-comments": {
        "description": "No surrounding comments or documentation",
        "maxCommentDensity": 0.05,
        "weight": 0.25
      },
      "one-liner-exports": {
        "description": "Functions are exported directly (export function/export const)",
        "weight": 0.20
      },
      "utility-pattern": {
        "description": "Small utility/helper functions, no class structure",
        "weight": 0.20
      }
    }
  }
}
